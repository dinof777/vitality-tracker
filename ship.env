# ship.env: the NAMES of the environment variables this repo's build needs. Never values.
# scripts/release/precheck.sh (Mission Control) supplies each name on the Mac mini from
# its environment or $MC_SHIP_ENV_DIR/<repo>.env, and fails naming any it cannot supply.
# It also fails if the source reads a NEXT_PUBLIC_ name that is not listed here.
# From the source's NEXT_PUBLIC_ reads and ship.yml's build step.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL?
DATABASE_URL
DATABASE_URL_UNPOOLED
